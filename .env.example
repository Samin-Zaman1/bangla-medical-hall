# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings → API). The service-role key is server-only — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Claude API key, used by purchase-invoice extraction (/api/purchase-invoices/extract).
ANTHROPIC_API_KEY=

# Optional: allows /api/setup/* in production when sent as the x-setup-secret header.
SETUP_SECRET=

# Optional: only for Prisma CLI commands (db:push, db:studio) — the app itself doesn't use it.
DATABASE_URL=
